<Project>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Version>0.1.3</Version>
    <Product>ChromaBridge</Product>
    <Description>Bridges Razer Chroma lighting to ASUS Aura and Corsair iCUE devices.</Description>
    <Copyright>Copyright (c) ChromaBridge contributors. Based on Chroma Control, copyright (c) 2021 Chroma Control Contributors.</Copyright>
    <!-- Every project builds into one folder so the service can find the host beside it -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)..\artifacts\bin\$(Configuration)\</OutputPath>
    <!-- Self-contained builds (the installer's publish) carry the runtime with them; keeping them
         apart stops a framework-dependent dev build from picking up that runtime's host files -->
    <OutputPath Condition="'$(SelfContained)' == 'true'">$(MSBuildThisFileDirectory)..\artifacts\bin\$(Configuration)-self-contained\</OutputPath>
  </PropertyGroup>

</Project>
