<Window x:Class="ChromaBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ChromaBridge.App"
        Title="ChromaBridge"
        Width="760" Height="820" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <!-- A toggle switch: WPF has no built-in one, so this restyles CheckBox -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderThickness="1" VerticalAlignment="Center"
                                    Background="Transparent" BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}">
                                <Ellipse x:Name="Thumb" Width="12" Height="12" Margin="3,0" HorizontalAlignment="Left"
                                         Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <ContentPresenter x:Name="Label" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="HasContent" Value="False">
                                <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Width" Value="14" />
                                <Setter TargetName="Thumb" Property="Height" Value="14" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="84" />
        </Style>

        <Style x:Key="SettingValue" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="40" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Version and updates: fixed at the bottom of the window, outside the scrolling area -->
        <Border DockPanel.Dock="Bottom" Padding="20,10" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                Visibility="{Binding Connected, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Check now" Command="{Binding CheckNowCommand}" IsEnabled="{Binding UpdateIdle}" Padding="14,5" VerticalAlignment="Center" Margin="12,0,0,0" />
                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding CheckForUpdates}" Content="Check for updates automatically" Margin="12,0,0,0"
                          ToolTip="Look for a new version once a day. Finding one only tells you; it is never installed without your say-so." />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource Secondary}" />
                    <TextBlock Text="{Binding UpdateText}" Style="{StaticResource Secondary}" />
                    <TextBlock Text="{Binding LastCheckedText}" Style="{StaticResource Secondary}"
                               Visibility="{Binding HasLastChecked, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </DockPanel>
        </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <DockPanel>
                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding StartsAtLogin}" Content="Start at login"
                          Visibility="{Binding Connected, Converter={StaticResource BoolToVisibility}}"
                          ToolTip="Start ChromaBridge when you log in to Windows. Changing this asks for administrator approval." />
                <Image x:Name="Lockup" Height="44" HorizontalAlignment="Left" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" ToolTip="ChromaBridge"
                       AutomationProperties.Name="ChromaBridge" />
            </DockPanel>
            <TextBlock Text="{Binding HelperText}" Style="{StaticResource Secondary}" Margin="0,4,0,16" />

            <!-- Shown when a newer version is waiting. Nothing is downloaded until Install is clicked. -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Install" Command="{Binding InstallUpdateCommand}" Padding="20,6" VerticalAlignment="Center"
                            Style="{DynamicResource AccentButtonStyle}" />
                    <StackPanel>
                        <TextBlock Text="{Binding UpdateTitle}" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,0"
                                   Text="Installing downloads the new version, checks that it is a genuine release, and restarts ChromaBridge. Lighting pauses for a few seconds." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Shown when the helper cannot be reached -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding NotConnected, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="The helper does the lighting" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,12"
                               Text="It runs in the background and keeps your devices following Razer Chroma, even when this window is closed. It needs administrator rights because ASUS only reports devices to an administrator." />
                    <Button Content="Start helper" Command="{Binding StartHelperCommand}" HorizontalAlignment="Left" Padding="16,6" />
                </StackPanel>
            </Border>

            <!-- One column of cards in a narrow window, two side by side in a wide one -->
            <ItemsControl ItemsSource="{Binding Providers}" Margin="-6,-6,-6,0" Visibility="{Binding Connected, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <!-- Narrow: a plain stack, so each card is only as tall as its content -->
                        <Setter Property="ItemsPanel">
                            <Setter.Value>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CardColumns, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" Value="2">
                                <Setter Property="ItemsPanel">
                                    <Setter.Value>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" VerticalAlignment="Top" />
                                        </ItemsPanelTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ProviderViewModel}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>

                                <!-- Name, state and the on/off switch -->
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Enabled}"
                                              ToolTip="Turn this provider on or off" AutomationProperties.Name="{Binding DisplayName}" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Ellipse Width="10" Height="10" Margin="12,1,6,0" VerticalAlignment="Center">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="{Binding StateColor}" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock Text="{Binding StateText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>

                                <TextBlock Text="{Binding Message}" Style="{StaticResource Secondary}" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding ChromaText}" Style="{StaticResource Secondary}" />
                                <TextBlock Text="{Binding HintText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibility}}" />

                                <!-- Devices -->
                                <StackPanel Visibility="{Binding HasDevices, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
                                    <TextBlock Text="Devices" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding Devices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:DeviceViewModel}">
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="176" />
                                                        <ColumnDefinition Width="152" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IsDriven}" Content="{Binding Name}" ToolTip="Turn off to leave this device alone" />
                                                    <TextBlock Grid.Column="1" Text="{Binding LightsText}" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="12,0" />
                                                    <ComboBox Grid.Column="2" ItemsSource="{Binding MappingOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Mapping"
                                                              SelectedValue="{Binding Mapping}" IsEnabled="{Binding IsDriven}" VerticalAlignment="Center"
                                                              ToolTip="How the five Chroma Link colors are laid out along this device's lights" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Rate}" Style="{StaticResource Secondary}" VerticalAlignment="Center" TextAlignment="Right" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Color -->
                                <TextBlock Text="Color" FontWeight="SemiBold" Margin="0,14,0,4" />

                                <DockPanel Margin="0,2">
                                    <TextBlock Text="Gamma" Style="{StaticResource SettingLabel}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Gamma, StringFormat=F2}" Style="{StaticResource SettingValue}" />
                                    <Slider Minimum="1" Maximum="3" Value="{Binding Gamma}" SmallChange="0.05" LargeChange="0.2" VerticalAlignment="Center"
                                            ToolTip="Higher makes mixed colors deeper. 1 leaves colors unchanged." />
                                </DockPanel>

                                <DockPanel Margin="0,2">
                                    <TextBlock Text="Saturation" Style="{StaticResource SettingLabel}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Saturation, StringFormat=F2}" Style="{StaticResource SettingValue}" />
                                    <Slider Minimum="0" Maximum="2" Value="{Binding Saturation}" SmallChange="0.05" LargeChange="0.2" VerticalAlignment="Center"
                                            ToolTip="1 leaves colors unchanged. Higher pushes colors further from white." />
                                </DockPanel>

                                <DockPanel Margin="0,2">
                                    <TextBlock Text="Brightness" Style="{StaticResource SettingLabel}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Brightness, StringFormat=F2}" Style="{StaticResource SettingValue}" />
                                    <Slider Minimum="0" Maximum="1" Value="{Binding Brightness}" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center" />
                                </DockPanel>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
    </DockPanel>
</Window>
