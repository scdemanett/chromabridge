# EditorConfig: https://EditorConfig.org
root = true

[*]
indent_style = space
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,slnx,xaml}]
charset = utf-8

[*.cs]
indent_size = 4
file_header_template = Licensed under the MIT license. See LICENSE.txt in the project root.
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = when_multiline:suggestion
dotnet_sort_system_directives_first = true

[*.{csproj,props,slnx,xaml}]
indent_size = 2

[*.{ps1,iss}]
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
